    {
      "id": "WyAbQAhenszNuAMa05AyQ",
      "type": "text",
      "x": 470.5715804327092,
      "y": 635.0819698515393,
      "width": 2193.9197476550526,
      "height": 527.1431274414064,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHu",
      "roundness": null,
      "seed": 1856632018,
      "version": 385,
      "versionNonce": 912473170,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1791803957629,
      "created": 1791581030005,
      "link": null,
      "locked": false,
      "text": "    def reverse_string(s: str):\n        l = list(s)\n        def helper(i: int):\n            if i == len(s) - 1:\n                return l[i]\n            else:\n                return helper(i+1)+l[i]\n       return helper(0)",
      "fontSize": 52.71431274414065,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "    def reverse_string(s: str):\n        l = list(s)\n        def helper(i: int):\n            if i == len(s) - 1:\n                return l[i]\n            else:\n                return helper(i+1)+l[i]\n       return helper(0)",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "M48Ndj3W_jboq07-z3ESM",
      "type": "text",
      "x": 504.8140167093534,
      "y": 1232.7963253202893,
      "width": 3035.711601311969,
      "height": 449.9289474487303,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bI2",
      "roundness": null,
      "seed": 1727954318,
      "version": 1067,
      "versionNonce": 1102768590,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1791803957629,
      "created": 1791581152842,
      "link": null,
      "locked": false,
      "text": "helper(0) suspends, waits helper(1) + \"a\"\nhelper(1) suspeds waits helper(2) + \"b\"\nhelper(2) hits the base case return \"c\"\n\"c\" goes to helper(1) ->\"c\" + \"b\" = \"cb\"\n\"cb\" goes to helper(0) ->\"cb\" + \"a\" = \"cba\"\n                      ",
      "fontSize": 59.99052632649738,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "helper(0) suspends, waits helper(1) + \"a\"\nhelper(1) suspeds waits helper(2) + \"b\"\nhelper(2) hits the base case return \"c\"\n\"c\" goes to helper(1) ->\"c\" + \"b\" = \"cb\"\n\"cb\" goes to helper(0) ->\"cb\" + \"a\" = \"cba\"\n                      ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
